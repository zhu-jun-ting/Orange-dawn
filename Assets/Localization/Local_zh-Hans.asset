    m_Localized: "\u867D\u7136\u8FD9\u4E2A\u6E38\u620F\u662F\u5728\u5306\u5FD9\u4E2D\u5F00\u53D1\u7684\uFF0C\u800C\u4E14\u5168\u7A0B\u7531\u6211\u4E00\u4E2A\u4EBA\u5B8C\u6210\uFF0Cbug\u592A\u591A\u4E86\u592A\u591A\u4E86\u592A\u591A\u4E86\u4E86\u4E86\u4E86\u4E86\u3002\u4E3A\u4E86\u907F\u514D\u5361\u4F4F\u5728\u4E00\u4E9B\u5947\u602A\u7684bug\u4E2D\uFF0C\u63D0\u4F9B\u4E86\u4EE5\u4E0B\u63A7\u5236\u53F0\u547D\u4EE4\u3002\n\u53EA\u9700\u5728\u7B2C\u4E00\u4E2A\u6846\u4E2D\u8F93\u5165\u540D\u5B57\uFF0C\u5728\u4E0B\u65B9\u6846\u4E2D\u8F93\u5165\u53C2\u6570\uFF08\u5982\u679C\u6709\u7684\u8BDD\uFF09\u3002\n\nAddCard(int
